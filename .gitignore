# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright session temp files
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# regenerable Figma asset cache — URLs expire ~7 days, re-run `npm run extract`
/public/figma-assets/
.env*.local
.review-artifacts/

# Local review captures (Playwright screenshots, etc.) — kept out of git
marks-*.png
switcher-*.png
print-marks-*.png
audit-*.png
review-*.png
smart-shuffle-*.png
phase*-*.png
.claude/

# Tester sessions (Playwright / Claude) are noise, not the record.
data/playtest/_claude/
